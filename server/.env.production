# ============================================
#  SRServi - PRODUCCIÓN
#  start.sh copia este archivo a .env con: ./start.sh  (o ./start.sh prod)
# ============================================

# MercadoPago Configuration - PRODUCCIÓN
MP_ENVIRONMENT=production

# Tokens de producción (APP_PROD-)
# Genera tus tokens en: https://dashboard.mercadopago.com/apps
MP_ACCESS_TOKEN=APP_USR-8905745887447867-040515-5b4c23c566da335c695b10bc4c6ede06-2937004186
MP_PUBLIC_KEY=APP_USR-fedc67fd-7706-4308-8db9-3533b2c00f72

# MercadoPago Webhook Secret
MP_WEBHOOK_SECRET=srservi_webhook_secret_2024

# URLs de callback (para MercadoPago y redirects)
BASE_URL=https://srservi2.srautomatic.com
CLIENT_URL=https://srservi2.srautomatic.com

# Dominios adicionales que Nginx también debe servir (separados por espacio)
# Ejemplo: EXTRA_DOMAINS=otrodominio.com www.otrodominio.com
EXTRA_DOMAINS=

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8888
CLIENT_HOST=0.0.0.0
CLIENT_PORT=6666
NODE_ENV=production

# JWT Configuration
JWT_SECRET=srservi_jwt_secret_key_2024

# Subdomain / Nginx
# Set these for automatic HTTPS on custom subdomains (wildcard cert)
# WILDCARD_CERT=/etc/letsencrypt/live/srautomatic.com/fullchain.pem
# WILDCARD_KEY=/etc/letsencrypt/live/srautomatic.com/privkey.pem
# NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
# NGINX_SITES_ENABLED=/etc/nginx/sites-enabled

# Email Configuration
EMAIL_USER=support@srautomatic.com
EMAIL_PASS=83324199a
EMAIL_HOST=163.227.179.59
EMAIL_PORT=587

# ============================================
#  León IA (Ollama + FastAPI)
# ============================================
# En producción solo accesible desde el propio servidor
LEON_HOST=127.0.0.1
LEON_PORT=7777
OLLAMA_URL=http://127.0.0.1:11434
# Modelo forzado (opcional). Si se omite: qwen2.5:7b con GPU, qwen2.5:3b sin GPU
# LEON_MODEL=qwen2.5:7b

# Base de datos (usada por León IA)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# OJO: la contraseña lleva comillas porque contiene '#'
# (sin comillas, el .env corta el valor en el '#')
DB_PASSWORD="@Fam#+234"
DB_NAME=srservi

# ============================================
#  Generador de Imágenes IA (FLUX.1-schnell)
# ============================================
# El modelo es "gated" en Hugging Face (aprobación automática, sin costo):
# 1. Crear cuenta en https://huggingface.co
# 2. Aceptar la licencia en https://huggingface.co/black-forest-labs/FLUX.1-schnell
# 3. Generar un token (read) en https://huggingface.co/settings/tokens
# 4. Pegarlo abajo. Sin esto, la descarga del modelo falla con error de autenticación.
HF_TOKEN=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
AI_IMAGE_PORT=8788
