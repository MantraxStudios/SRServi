<?xml version="1.0" encoding="utf-8"?>
<!--
  PlayerView con surface_type="texture_view".
  Un TextureView se dibuja dentro de la jerarquía de vistas (a diferencia de un
  SurfaceView, que el sistema compone en una capa aparte e ignora las
  transformaciones del padre). Esto permite que la rotación aplicada por Compose
  (graphicsLayer/rotationZ en RotatingContent) también rote el video.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="zoom" />
