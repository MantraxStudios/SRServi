<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarMulti"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:navigationIconTint="@color/gold"
        app:title="Impresoras adicionales"
        app:titleTextColor="@color/gold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Estado del plan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_rounded"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvMultiPlanStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Verificando plan..."
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="El Plan Empresas permite conectar hasta 5 impresoras Bluetooth. Cada pedido se imprimirá en todas las impresoras conectadas."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- Contador -->
            <TextView
                android:id="@+id/tvMultiPrinterCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Impresoras adicionales: 0"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Lista de impresoras adicionales -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvExtraPrinters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:nestedScrollingEnabled="false" />

            <!-- Botón agregar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddExtraPrinter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:minHeight="56dp"
                android:text="Agregar impresora adicional"
                android:textSize="16sp"
                app:backgroundTint="@color/gold"
                app:cornerRadius="32dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
