<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCartName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Producto"
            android:textColor="@color/kiosk_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCartExtras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text=""
            android:textColor="@color/kiosk_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvCartLineTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="$0"
            android:textColor="@color/kiosk_orange"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnMinus"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_qty_button"
        android:contentDescription="Menos"
        android:src="@android:drawable/ic_media_previous"
        app:tint="@color/kiosk_dark" />

    <TextView
        android:id="@+id/tvQty"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/kiosk_dark"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/btnPlus"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_qty_button"
        android:contentDescription="Más"
        android:src="@android:drawable/ic_media_next"
        app:tint="@color/kiosk_dark" />

</LinearLayout>
