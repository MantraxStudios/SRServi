# ── Configuración del stack de telefonía IA ──
# Generado automáticamente. El TELEPHONY_BOT_TOKEN DEBE coincidir con el de
# server/.env (y .env.production / .env.development).

# URL pública de tu servidor SRServi (backend Node)
SRSERVI_URL=https://srservi2.srautomatic.com

# Token compartido entre el bot y SRServi (mismo valor que en server/.env)
TELEPHONY_BOT_TOKEN=512a6dd54e48567e4ea219afafd3f5debbbb35dee8ae53b66d24444839baf777

# Modelo de Whisper: tiny | base | small | medium | large-v3
WHISPER_MODEL=small

# Sensibilidad del detector de voz (RMS). Súbelo si corta al cliente por ruido,
# bájalo si no detecta cuando habla bajo.
VAD_THRESHOLD=600
