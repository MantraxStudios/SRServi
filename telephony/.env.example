# ── Configuración del stack de telefonía IA ──
# Copia este archivo a .env y complétalo.

# URL pública de tu servidor SRServi (backend Node)
SRSERVI_URL=https://srservi2.srautomatic.com

# Token compartido entre el bot y SRServi. DEBE coincidir con la variable
# TELEPHONY_BOT_TOKEN del .env del servidor SRServi. Genera uno largo y secreto.
TELEPHONY_BOT_TOKEN=cambia-esto-por-un-token-largo-y-secreto

# ── Twilio: Programmable Voice (NO Elastic SIP Trunking) ──
# La plataforma usa Twilio: número (DID) comprado en Twilio + Auth Token + Voice
# webhook. NO se registra un SIP trunk con usuario/clave. El flujo:
#   1. Entra la llamada → Twilio hace un POST firmado (X-Twilio-Signature) al
#      backend SRServi (/api/telephony/twilio/callback).
#   2. SRServi responde TwiML <Dial><Sip> apuntando a ESTE Asterisk.
#   3. Twilio abre el INVITE desde sus IPs de señalización hacia este Asterisk.
#
# El Auth Token y el host SIP van en el .env del SERVIDOR SRServi (es quien recibe
# el webhook), NO aquí:
#   TWILIO_AUTH_TOKEN=...                     # Account > Auth Token del panel de Twilio
#   TELEPHONY_SIP_HOST=tu-dominio-publico     # host de este Asterisk (mismo server)
#   TWILIO_WEBHOOK_URL=https://TU_DOMINIO/api/telephony/twilio/callback  # (recomendado)
#
# Aquí (stack Asterisk) solo se acepta el INVITE entrante por la IP de señalización
# de Twilio. Opcional: acota los CIDR permitidos (por defecto, todos los de Twilio).
# Para Chile suele bastar São Paulo (br1): 177.71.206.192/30
TWILIO_SIP_IPS=
# Puerto en el que Asterisk escucha SIP (debe ser alcanzable desde Twilio).
SIP_BIND_PORT=5060

# Modelo de Whisper: tiny | base | small | medium | large-v3
# (small es buen equilibrio calidad/velocidad en español)
WHISPER_MODEL=small

# Sensibilidad del detector de voz (RMS). Súbelo si corta al cliente por ruido,
# bájalo si no detecta cuando habla bajo.
VAD_THRESHOLD=600
