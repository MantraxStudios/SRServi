# ── Configuración del stack de telefonía IA ──
# Copia este archivo a .env y complétalo.

# URL pública de tu servidor SRServi (backend Node)
SRSERVI_URL=https://srservi2.srautomatic.com

# Token compartido entre el bot y SRServi. DEBE coincidir con la variable
# TELEPHONY_BOT_TOKEN del .env del servidor SRServi. Genera uno largo y secreto.
TELEPHONY_BOT_TOKEN=cambia-esto-por-un-token-largo-y-secreto

# Modelo de Whisper: tiny | base | small | medium | large-v3
# (small es buen equilibrio calidad/velocidad en español)
WHISPER_MODEL=small

# Sensibilidad del detector de voz (RMS). Súbelo si corta al cliente por ruido,
# bájalo si no detecta cuando habla bajo.
VAD_THRESHOLD=600
