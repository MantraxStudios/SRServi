# ── Configuración del stack de telefonía IA ──
# Copia este archivo a .env y complétalo.

# URL pública de tu servidor SRServi (backend Node)
SRSERVI_URL=https://srservi2.srautomatic.com

# Token compartido entre el bot y SRServi. DEBE coincidir con la variable
# TELEPHONY_BOT_TOKEN del .env del servidor SRServi. Genera uno largo y secreto.
TELEPHONY_BOT_TOKEN=cambia-esto-por-un-token-largo-y-secreto

# ── Sinch: Voice API (NO SIP trunking) ──
# La plataforma usa la VOICE API de Sinch: número (DID) + Application Key/Secret +
# Callback. NO se registra un SIP trunk con usuario/clave. El flujo:
#   1. Entra la llamada → Sinch hace un POST firmado al backend SRServi
#      (/api/telephony/sinch/callback), validado con el Application Secret.
#   2. SRServi responde SVAML `connectSip` apuntando a ESTE Asterisk.
#   3. Sinch abre el INVITE desde sus media servers hacia este Asterisk.
#
# El Application Key/Secret van en el .env del SERVIDOR SRServi (es quien recibe
# el callback), NO aquí:
#   SINCH_APP_KEY=...
#   SINCH_APP_SECRET=...
#   TELEPHONY_SIP_HOST=tu-dominio-publico   # host de este Asterisk (mismo server)
#
# Aquí (stack Asterisk) solo se acepta el INVITE entrante por la IP de los media
# servers de Sinch. Opcional: acota los CIDR permitidos (por defecto, todos los
# de Sinch). Para Chile basta Sudamérica: 206.146.138.0/28
SINCH_SIP_IPS=
# Puerto en el que Asterisk escucha SIP (debe ser alcanzable desde Sinch).
SIP_BIND_PORT=5060

# Modelo de Whisper: tiny | base | small | medium | large-v3
# (small es buen equilibrio calidad/velocidad en español)
WHISPER_MODEL=small

# Sensibilidad del detector de voz (RMS). Súbelo si corta al cliente por ruido,
# bájalo si no detecta cuando habla bajo.
VAD_THRESHOLD=600
